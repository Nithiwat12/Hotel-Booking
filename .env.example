# Copy this file to .env and replace the placeholders with your Neon values.
# The application automatically retries Neon's documented endpoint-in-password
# workaround if an older XAMPP/libpq build cannot send TLS SNI.
DATABASE_URL="postgresql://USERNAME:YOUR_NEON_PASSWORD@YOUR_ENDPOINT_HOST/neondb?sslmode=require"

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/hotel

# Optional local PostgreSQL fallback (used only when DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=hotel
# PGUSER=postgres
# PGPASSWORD=change_me
# PGSSLMODE=prefer
